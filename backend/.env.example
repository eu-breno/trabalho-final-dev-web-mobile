# PostgreSQL local definido pelo docker-compose.yml da raiz.
DATABASE_URL="postgresql://app:app@localhost:5433/appdb?schema=public"

# Segredo apenas para desenvolvimento local; substitua em cada ambiente.
JWT_SECRET="segredo-local-de-desenvolvimento"

# Porta HTTP da API.
PORT=3000

# Credenciais fictícias usadas pelo seed local; altere a senha antes de rodar.
ADMIN_EMAIL="admin@exemplo.local"
ADMIN_SENHA="senha-local-ficticia-1234"
ADMIN_NOME="Administrador de desenvolvimento"