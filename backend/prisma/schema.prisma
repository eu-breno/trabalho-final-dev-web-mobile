generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String    @id @default(uuid())
  nome      String
  email     String    @unique
  senhaHash String
  perfil    Perfil    @default(estudante)
  baralhos  Baralho[]

  turmas TurmaUsuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Perfil {
  estudante
  administrador
}

model Turma {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  codigo    String  @unique

  membros  TurmaUsuario[]
  baralhos Baralho[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TurmaUsuario {
  id        String   @id @default(uuid())
  usuarioId String
  turmaId   String
  entrouEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  turma   Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, turmaId]) // Evita que o usuário entre na mesma turma duas vezes
}

model Baralho {
  id        String  @id @default(uuid())
  nome      String
  descricao String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  turmaId String?
  turma   Turma?  @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  cartoes Cartao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, nome])
}

model Cartao {
  id     String @id @default(uuid())
  frente String
  verso  String

  baralhoId String
  baralho   Baralho @relation(fields: [baralhoId], references: [id], onDelete: Cascade)

  facilidade     Float     @default(2.5)
  repeticoes     Int       @default(0)
  intervaloDias  Int       @default(0)
  proximaRevisao DateTime  @default(now())
  ultimaRevisao  DateTime?

  revisoes Revisao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baralhoId, proximaRevisao])
}

enum Nota {
  errei
  dificil
  bom
  facil
}

model Revisao {
  id       String @id @default(uuid())
  cartaoId String
  cartao   Cartao @relation(fields: [cartaoId], references: [id], onDelete: Cascade)

  nota                  Nota
  intervaloAnteriorDias Int
  intervaloNovoDias     Int
  revisadoEm            DateTime @default(now())
}
