@host = http://localhost:3000

### Registrar um usuario
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nome": "Matheus 2",
  "email": "m@exemplo.com",
  "senha": "12345678"
}

### Login de um usuario
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "m@exemplo.com",
  "senha": "12345678"
}