@host = http://localhost:3000

### Registrar um usuario
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nome": "Ana Souza",
  "email": "ana@exemplo.com",
  "senha": "umaSenhaForte123"
}

### Login de um usuario
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "ana@exemplo.com",
  "senha": "umaSenhaForte123"
}